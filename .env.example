# Server (.env on VPS at /opt/budgic-app/.env)
PORT=3001
HOST=127.0.0.1
ALLOWED_DEVICE_IDS=
BACKUP_DIR=/var/lib/budgic-app/backups
BODY_SIZE_LIMIT=52428800

# Dev only: skip device allowlist (never set in production)
# ALLOW_DEVICE_AUTH_BYPASS=true
#
# Backups: BACKUP_DIR/<deviceId>/latest.json + timestamped *.json
# GET /api/backup/latest — newest file with >=1 account or transaction; scans all device
#   folders if needed (recovery after clear-site-data / new Device ID).
# POST /api/backup — skips storing empty payload if device already has user data.
# Client does not auto-push while local accounts and transactions are both zero.
